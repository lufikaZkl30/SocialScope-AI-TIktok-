# Copy to .env (never commit .env)
FLASK_DEBUG=1
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=5
MAX_ROWS=5000
SIMILARITY_THRESHOLD=0.80
# Optional: path to a JSON file overriding promotional keyword categories
# PROMO_KEYWORDS_PATH=./promo_keywords.json
# TikTok Login Kit app credentials (never put these in frontend variables).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Local callback; for Vercel, use https://<your-domain>/api/tiktok/callback.
TIKTOK_REDIRECT_URI=http://localhost:5173/api/tiktok/callback
TIKTOK_FRONTEND_URL=http://localhost:5173
# Use a stable random secret in production; local development generates a temporary value.
FLASK_SECRET_KEY=
# Set to 1 only when deployed over HTTPS.
SESSION_COOKIE_SECURE=0

