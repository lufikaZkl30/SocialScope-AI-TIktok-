# Copy to .env (never commit .env)
FLASK_DEBUG=1
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=5
MAX_ROWS=5000
SIMILARITY_THRESHOLD=0.80
# Optional: path to a JSON file overriding promotional keyword categories
# PROMO_KEYWORDS_PATH=./promo_keywords.json
# Reserved for a future, authorized TikTok API connector. Leave empty if you have none.
# Setting this does NOT enable comment retrieval by itself; see integrations/tiktok.py
TIKTOK_API_ACCESS_TOKEN=
